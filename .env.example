# Environment variables read by the API and the worker.
# This file documents names only. Never commit real values.

# --- Required (API) ---
# At least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=

# --- Database (API + worker). Defaults shown match the local setup in the README. ---
DB_URL=jdbc:postgresql://localhost:5432/progresstracker
DB_USERNAME=ptrack
DB_PASSWORD=ptrack

# --- Async pipeline (API + worker) ---
# false: rewards are computed inline, no AWS needed.
# true: completions go through SQS. Needs QUEUE_SQS_URL and AWS credentials.
QUEUE_ENABLED=false
QUEUE_SQS_URL=
AWS_REGION=us-west-1
# Leave blank for real AWS. Set to reach a local SQS-compatible broker (see compose.yaml).
QUEUE_ENDPOINT_OVERRIDE=
# How often (ms) the API's outbox relay looks for unpublished events. Only used when QUEUE_ENABLED=true.
OUTBOX_RELAY_DELAY_MS=500

# --- Scheduled automations (API) ---
# Shared secret the Lambdas send as X-Internal-Token. Blank keeps the endpoints locked.
AUTOMATION_TOKEN=
