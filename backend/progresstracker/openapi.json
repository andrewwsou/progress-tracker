            "enum" : [
              "DAILY",
              "WEEKLY"
            ],
            "type" : "string"
          },
          "goalTargetCount" : {
            "format" : "int32",
            "maximum" : 365,
            "minimum" : 1,
            "type" : "integer"
          },
          "name" : {
            "maxLength" : 100,
            "minLength" : 1,
            "type" : "string"
          }
        },
        "required" : [
          "frequency",
          "name"
        ],
        "type" : "object"
      },
      "HabitResponse" : {
        "properties" : {
          "createdAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "currentStreak" : {
            "format" : "int32",
            "type" : "integer"
          },
          "description" : {
            "type" : "string"
          },
          "frequency" : {
            "enum" : [
              "DAILY",
              "WEEKLY"
            ],
            "type" : "string"
          },
          "goalPeriod" : {
            "enum" : [
              "DAILY",
              "WEEKLY"
            ],
            "type" : "string"
          },
          "goalTargetCount" : {
            "format" : "int32",
            "type" : "integer"
          },
          "id" : {
            "format" : "int64",
            "type" : "integer"
          },
          "lastCompletedDate" : {
            "format" : "date",
            "type" : "string"
          },
          "longestStreak" : {
            "format" : "int32",
            "type" : "integer"
          },
          "name" : {
            "type" : "string"
          },
          "progressCount" : {
            "description" : "Completions so far in the current goal period",
            "format" : "int32",
            "type" : "integer"
          },
          "progressTargetCount" : {
            "format" : "int32",
            "type" : "integer"
          },
          "xpTotal" : {
            "format" : "int32",
            "type" : "integer"
          }
